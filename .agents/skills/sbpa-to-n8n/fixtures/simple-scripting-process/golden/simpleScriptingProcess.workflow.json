      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Initialize custom variables from $execution.customData.\n// Fields with defaults from StartEvent are seeded only if not already set.\nconst cd = $execution.customData.getAll();\n\nreturn [{ json: { custom: $execution.customData.getAll(), ...$('StartEvent').item.json } }];"
      }
    },
    {
      "id": "n8n-2",
