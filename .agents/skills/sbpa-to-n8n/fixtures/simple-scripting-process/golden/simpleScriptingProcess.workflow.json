    {
      "id": "n8n-4",
      "name": "Script Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Migrated from SBPA ScriptTask script_1\n// v1 rewrite: $.context.startEvent → $('StartEvent').item.json (cross-node ref),\n//             $.context.custom.*   → $execution.customData (read + write).\n// NOTE: $execution.customData is string-only (max key=50, value=255, items=10).\nconst custom = Object.assign({}, $execution.customData.getAll());\n\nvar i = 0;\nfor (i = 0; i < $('StartEvent').item.json.body.firstnames.length; i++) {\n\tcustom.names.push($('StartEvent').item.json.body.firstnames[i] \n\t+ $('StartEvent').item.json.body.lastnames[i]);\n}\n\n\n// Persist mutations back to $execution.customData (string values only).\nfor (const [_k, _v] of Object.entries(custom)) {\n  $execution.customData.set(_k, String(_v));\n}\nreturn { ...$json, custom: $execution.customData.getAll() };"
      }
    },
    {
      "id": "n8n-5",
      "name": "Read Custom Data: EndEvent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Load $execution.customData into $json.custom for downstream formula access.\nreturn [ {custom: $execution.customData.getAll()} ];"
      }
    }
  ],
