      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "end-names",
              "name": "names",
              "type": "array",
              "value": "={{ $('Read Custom Data: EndEvent').item.json.custom.names }}"
            }
          ]
        },
        "options": {}
