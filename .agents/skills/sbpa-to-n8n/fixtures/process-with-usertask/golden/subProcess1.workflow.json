      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Migrated from SBPA GenericSkillTask (ScriptTask) ScriptTask_1\n// v1 rewrite: $.context.startEvent → $('StartEvent').item.json (cross-node ref),\n//             $.context.custom.*   → $execution.customData (read + write).\n// NOTE: $execution.customData is string-only (max key=50, value=255, items=10).\nconst custom = Object.assign({}, $execution.customData.getAll());\n\n/*\n// read from existing process data/context\nvar productInfo = custom.productInfo;\nvar productName = productInfo.productName;\nvar productDescription = productInfo.productDescription;\n\n// read contextual information\nvar workflowInstanceId = $.info.workflowInstanceId;\n\n// read user task information\nvar lastUserTask1 = $.usertasks.usertask1.last;\nvar userTaskSubject = lastUserTask1.subject;\nvar userTaskProcessor = lastUserTask1.processor;\nvar userTaskCompletedAt = lastUserTask1.completedAt;\n\nvar userTaskStatusMessage = \" User task '\" + userTaskSubject + \"' has been completed by \" + userTaskProcessor + \" at \" + userTaskCompletedAt;\n\n// create new node 'product'\nvar product = {\n\t\tproductDetails: productName  + \" \" + productDescription,\n\t\tworkflowStep: workflowInstanceId\n};\n\n// write 'product' node to process data/context\ncustom.product = product;\n*/\ncustom.approvaltype = \"Manual\"\n\n// Persist mutations back to $execution.customData (string values only).\nfor (const [_k, _v] of Object.entries(custom)) {\n  $execution.customData.set(_k, String(_v));\n}\nreturn { ...$json };"
      }
    },
    {
      "id": "n8n-11",
      "name": "Script Task 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Migrated from SBPA GenericSkillTask (ScriptTask) ScriptTask_2\n// v1 rewrite: $.context.startEvent → $('StartEvent').item.json (cross-node ref),\n//             $.context.custom.*   → $execution.customData (read + write).\n// NOTE: $execution.customData is string-only (max key=50, value=255, items=10).\nconst custom = Object.assign({}, $execution.customData.getAll());\n\n/*\n// read from existing process data/context\nvar productInfo = custom.productInfo;\nvar productName = productInfo.productName;\nvar productDescription = productInfo.productDescription;\n\n// read contextual information\nvar workflowInstanceId = $.info.workflowInstanceId;\n\n// read user task information\nvar lastUserTask1 = $.usertasks.usertask1.last;\nvar userTaskSubject = lastUserTask1.subject;\nvar userTaskProcessor = lastUserTask1.processor;\nvar userTaskCompletedAt = lastUserTask1.completedAt;\n\nvar userTaskStatusMessage = \" User task '\" + userTaskSubject + \"' has been completed by \" + userTaskProcessor + \" at \" + userTaskCompletedAt;\n\n// create new node 'product'\nvar product = {\n\t\tproductDetails: productName  + \" \" + productDescription,\n\t\tworkflowStep: workflowInstanceId\n};\n\n// write 'product' node to process data/context\ncustom.product = product;\n*/\n\ncustom.approvaltype = \"Auto\"\n\n// Persist mutations back to $execution.customData (string values only).\nfor (const [_k, _v] of Object.entries(custom)) {\n  $execution.customData.set(_k, String(_v));\n}\nreturn { ...$json };"
      }
