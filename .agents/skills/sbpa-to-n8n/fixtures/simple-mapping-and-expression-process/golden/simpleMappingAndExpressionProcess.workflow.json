{
  "name": "SimpleMappingAndExpressionProcess",
  "nodes": [
    {
      "id": "n8n-1",
      "name": "StartEvent",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "startprocess",
        "responseMode": "onReceived"
      },
      "webhookId": "418ece83-c882-46c8-b4ef-67c4579b1c8b"
    },
    {
      "id": "n8n-2",
      "name": "EndEvent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "end-acomplextype",
              "name": "acomplextype",
              "type": "object",
              "value": "={{ $('StartEvent').item.json.body.acomplextype }}"
            },
            {
              "id": "end-acomplextypelist",
              "name": "acomplextypelist",
              "type": "array",
              "value": "={{ ($('StartEvent').item.json.body.acomplextypelist).map(item => ({ \"aNumber\": item.aNumber, \"aString\": item.aString })) }}"
            },
            {
              "id": "end-anumber",
              "name": "anumber",
              "type": "number",
              "value": "={{ $('StartEvent').item.json.body.anumber }}"
            },
            {
              "id": "end-anumberlist",
              "name": "anumberlist",
              "type": "array",
              "value": "={{ $('StartEvent').item.json.body.anumberlist }}"
            },
            {
              "id": "end-astring",
              "name": "astring",
              "type": "string",
              "value": "={{ \"asdf\" }}"
            },
            {
              "id": "end-astringlist",
              "name": "astringlist",
              "type": "array",
              "value": "={{ $('StartEvent').item.json.body.astringlist }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "StartEvent": {
      "main": [
        [
          {
            "node": "EndEvent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {
    "StartEvent": [
      {
        "body": {
          "astring": "",
          "anumber": 0,
          "astringlist": [],
          "anumberlist": [],
          "acomplextype": {
            "aString": "",
            "aNumber": ""
          },
          "acomplextypelist": [
            {
              "aString": "",
              "aNumber": ""
            }
          ]
        }
      }
    ]
  }
}
