      ],
      "parameters": {}
    },
    {
      "id": "n8n-2",
      "name": "Supplier Invoice Variance Approval",
      "type": "CUSTOM.sapTaskCenter",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "action": "sendApprovalTask",
        "subject": "Supplier Invoice Variance Approval",
        "priority": "MEDIUM",
        "description": "",
        "taskDefinition": {
          "definitionName": "Supplier Invoice Variance Approval"
        },
        "recipients": {
          "recipientValues": [
            {
              "userId": "={{ ($('Variance Approval').item.json.output.Approver_ID) }}"
            }
          ]
        }
      }
    },
    {
      "id": "n8n-3",
      "name": "Supplier Invoice Variance Approval Decision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        720,
        360
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "form_supplierInvoiceVarianceApproval_1-9497507f-f518-4f84-bcca-5198187303eb",
                    "leftValue": "={{ $('Supplier Invoice Variance Approval').item.json.result.response }}",
                    "rightValue": "approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": false
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "form_supplierInvoiceVarianceApproval_1-3f17040a-7548-4fe5-ad4a-14d35d422d3d",
                    "leftValue": "={{ $('Supplier Invoice Variance Approval').item.json.result.response }}",
                    "rightValue": "rejected",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": false
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
    {
      "id": "n8n-4",
      "name": "Send Rejection Mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        180
      ],
      "parameters": {
        "fromEmail": "sender@example.invalid",
        "toEmail": "={{ (info.startedBy) }}",
        "subject": "[Rejected] Supplier Invoice due to Variance",
        "emailFormat": "html",
        "html": "={{ \"<p>Hello,</p><p></p><p>Invoice(\" + ($('StartEvent').item.json.supplierInvoice) + \" ) Rejected due to variance of \" + ($('StartEvent').item.json.variance) + \" </p><p></p><p>Thanks,</p><p>Admin</p>\" }}",
        "options": {}
      }
    },
    {
      "id": "n8n-5",
      "name": "Reverses a supplier invoice and returns the reversal number.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SupplierInformation_baseUrl }}/Cancel",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "FiscalYear",
              "value": "={{ $('StartEvent').item.json.fiscalYear }}"
            },
            {
              "name": "PostingDate",
              "value": "={{ $('StartEvent').item.json.postingDate }}"
            },
            {
              "name": "ReversalReason",
              "value": "={{ \"Variance\" }}"
            },
            {
              "name": "SupplierInvoice",
              "value": "={{ $('Supplier Invoice Variance Approval').item.json.invoiceNumber }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SBPA destination: SupplierInformation"
        }
      }
    },
    {
      "id": "n8n-6",
      "name": "Releases a supplier invoice.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SupplierInformation_baseUrl }}/Release",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "DiscountDaysHaveToBeShifted",
              "value": "={{ $('StartEvent').item.json.discountDays }}"
            },
            {
              "name": "FiscalYear",
              "value": "={{ $('StartEvent').item.json.fiscalYear }}"
            },
            {
              "name": "SupplierInvoice",
              "value": "={{ $('StartEvent').item.json.supplierInvoice }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SBPA destination: SupplierInformation"
        }
      }
    },
    {
      "id": "n8n-7",
      "name": "Invoice Approved",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "fromEmail": "sender@example.invalid",
        "toEmail": "={{ (info.startedBy) }}",
        "subject": "={{ \"[Approved] Invoice \" + ($('StartEvent').item.json.supplierInvoice) + \"  is Approved\" }}",
        "emailFormat": "html",
        "html": "={{ \"<p>Hello,</p><p></p><p>Invoice \" + ($('StartEvent').item.json.supplierInvoice) + \"  is Released.</p><p></p><p>Thanks,</p><p>Admin</p>\" }}",
        "options": {}
      }
    },
    {
      "id": "n8n-8",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "append"
      }
    }
