        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "PurchaseOrder",
              "value": "={{ $('Reads supplier invoice data by key data.').item.json.result.d.to_SuplrInvcItemPurOrdRef.results[0].PurchaseOrder }}"
