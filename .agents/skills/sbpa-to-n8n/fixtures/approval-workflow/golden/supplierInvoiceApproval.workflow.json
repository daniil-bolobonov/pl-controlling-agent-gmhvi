    {
      "id": "n8n-8",
      "name": "Calculate Actual Variance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Migrated from SBPA ScriptTask script_3\n// v1 rewrite: $.context.startEvent → $('StartEvent').item.json (cross-node ref),\n//             $.context.custom.*   → $execution.customData (read + write).\n// NOTE: $execution.customData is string-only (max key=50, value=255, items=10).\nconst custom = Object.assign({}, $execution.customData.getAll());\n\nvar POtotalNetAmount = 0;\n\nfunction convertTextToNumber(value) {\n    var amount = parseFloat(value);\n    if (isNaN(amount)) {\n        return 0;\n    }\n    return amount;\n}\n\n// Get Invoice Amount\nvar InvoiceAmt = convertTextToNumber(\n    $('Reads supplier invoice data by key data.').item.json.result.d.InvoiceGrossAmount\n);\n\n// Sum all PO Item Net Prices\nvar items = $('Gets the header details of a purchase order').item.json.result.d.to_PurchaseOrderItem.results;\n\nfor (var i = 0; i < items.length; i++) {\n    POtotalNetAmount += convertTextToNumber(items[i].NetPriceAmount);\n}\n\n// Avoid divide by zero\nif (POtotalNetAmount !== 0) {\n    custom.variance =\n        ((InvoiceAmt - POtotalNetAmount) / POtotalNetAmount) * 100;\n} else {\n    custom.variance = 0;\n}\n\n// Persist mutations back to $execution.customData (string values only).\nfor (const [_k, _v] of Object.entries(custom)) {\n  $execution.customData.set(_k, String(_v));\n}\nreturn { ...$json, custom: $execution.customData.getAll() };"
      }
    },
