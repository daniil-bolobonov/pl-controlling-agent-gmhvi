        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Migrated from SBPA ScriptTask script_3\n// v1 rewrite: $.context.startEvent → $('StartEvent').item.json (cross-node ref),\n//             $.context.custom.*   → $execution.customData (read + write).\n// NOTE: $execution.customData is string-only (max key=50, value=255, items=10).\nconst custom = Object.assign({}, $execution.customData.getAll());\n\n/*\n// read from existing process data/context\nvar productInfo = custom.productInfo;\nvar productName = productInfo.productName;\nvar productDescription = productInfo.productDescription;\n\n// read contextual information\nvar workflowInstanceId = $.info.workflowInstanceId;\n\n// read user task information\nvar lastUserTask1 = $.usertasks.usertask1.last;\nvar userTaskSubject = lastUserTask1.subject;\nvar userTaskProcessor = lastUserTask1.processor;\nvar userTaskCompletedAt = lastUserTask1.completedAt;\n\nvar userTaskStatusMessage = \" User task '\" + userTaskSubject + \"' has been completed by \" + userTaskProcessor + \" at \" + userTaskCompletedAt;\n\n// create new node 'product'\nvar product = {\n\t\tproductDetails: productName  + \" \" + productDescription,\n\t\tworkflowStep: workflowInstanceId\n};\n\n// write 'product' node to process data/context\ncustom.product = product;\n*/\nvar bool = custom.customboolean;\nvar num = custom.customnumber;\nvar date = custom.customdate;\nvar datetime = custom.customdatetime;\nvar doc = custom.customdocument;\nvar str = custom.custstr;\ncustom.custstr = custom.custstr + ' Updated';\n\n// Persist mutations back to $execution.customData (string values only).\nfor (const [_k, _v] of Object.entries(custom)) {\n  $execution.customData.set(_k, String(_v));\n}\nreturn { ...$json, custom: $execution.customData.getAll() };"
      }
