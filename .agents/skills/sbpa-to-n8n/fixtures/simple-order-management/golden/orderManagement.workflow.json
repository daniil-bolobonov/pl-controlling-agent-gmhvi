      ],
      "parameters": {
        "fromEmail": "sender@example.invalid",
        "toEmail": "ops@example.com",
        "subject": "Check Order",
        "emailFormat": "html",
        "html": "={{ \"<p>Dear Ops Team,</p><p></p><p>please check this order: \" + ($('StartEvent').item.json.body.orderid) + \" .</p><p></p><p>Cheers </p>\" }}",
        "options": {}
      }
    },
    {
