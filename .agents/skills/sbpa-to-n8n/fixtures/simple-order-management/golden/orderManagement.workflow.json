                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "condition_1-6a88cb50-c717-4e8a-8c89-4d2a05b9e484",
                    "leftValue": "={{ $('Initialize Custom Data').item.json.custom.normalizedtotals.gross <= 10000 }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": false
            }
