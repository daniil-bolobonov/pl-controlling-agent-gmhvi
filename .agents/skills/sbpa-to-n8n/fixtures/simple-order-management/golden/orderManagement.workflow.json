{
  "name": "Order Management",
  "nodes": [
    {
      "id": "n8n-1",
      "name": "Initialize Custom Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Initialize custom variables from $execution.customData.\n// Fields with defaults from StartEvent are seeded only if not already set.\nconst cd = $execution.customData.getAll();\n\nreturn [{ json: { custom: $execution.customData.getAll(), ...$('StartEvent').item.json } }];"
      }
    },
    {
      "id": "n8n-2",
      "name": "StartEvent",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "new-order",
        "responseMode": "onReceived"
      },
      "webhookId": "d30240e5-eef5-45bc-9044-d82f775dafe7"
    },
    {
      "id": "n8n-3",
      "name": "Wait 10 minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 10,
        "unit": "minutes"
      }
    },
    {
      "id": "n8n-4",
      "name": "Script Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Migrated from SBPA ScriptTask script_1\n// v1 rewrite: $.context.startEvent → $('StartEvent').item.json (cross-node ref),\n//             $.context.custom.*   → $execution.customData (read + write).\n// NOTE: $execution.customData is string-only (max key=50, value=255, items=10).\nconst custom = Object.assign({}, $execution.customData.getAll());\n\nif ($('StartEvent').item.json.body.notes.indexOf(\"discount\") !== -1) {\n\t// Apply discount\n\tcustom.normalizedtotals.gross = $('StartEvent').item.json.body.totals.gross * 0.9;\n}\n\n\n// Persist mutations back to $execution.customData (string values only).\nfor (const [_k, _v] of Object.entries(custom)) {\n  $execution.customData.set(_k, String(_v));\n}\nreturn { ...$json, custom: $execution.customData.getAll() };"
      }
    },
    {
      "id": "n8n-5",
      "name": "Resolve Customer",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "resolveCustomer",
          "mode": "id",
          "cachedResultName": "Resolve Customer"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "customerid": "={{ $('StartEvent').item.json.body.customer.externalId }}"
          },
          "schema": [
            {
              "id": "customerid",
              "displayName": "customerid",
              "type": "string",
              "defaultMatch": false,
              "display": true,
              "required": false,
              "canBeUsedToMatch": false
            }
          ],
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "mode": "each",
        "options": {}
      }
    },
    {
      "id": "n8n-6",
      "name": "Create Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.erp_baseUrl }}/orders",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $('StartEvent').item.json.body.channel }}"
            },
            {
              "name": "currency",
              "value": "={{ $('StartEvent').item.json.body.currency }}"
            },
            {
              "name": "customer",
              "value": "={{ $('Resolve Customer').item.json.customer }}"
            },
            {
              "name": "incoterms",
              "value": "={{ $('StartEvent').item.json.body.incoterms }}"
            },
            {
              "name": "lines",
              "value": "={{ ($('StartEvent').item.json.body.lines).map(item => ({ \"description\": item.description, \"lineNo\": item.lineNo, \"lineTotal\": item.lineTotal, \"materialNumber\": item.materialNumber, \"quantity\": item.quantity, \"unitOfMeasure\": item.unitOfMeasure, \"unitPrice\": item.unitPrice })) }}"
            },
            {
              "name": "notes",
              "value": "={{ $('StartEvent').item.json.body.notes }}"
            },
            {
              "name": "orderId",
              "value": "={{ $('StartEvent').item.json.body.orderid }}"
            },
            {
              "name": "paymentTerms",
              "value": "={{ $('StartEvent').item.json.body.paymentterms }}"
            },
            {
              "name": "receivedAt",
              "value": "={{ $('StartEvent').item.json.body.receivedat }}"
            },
            {
              "name": "requestedDeliveryDate",
              "value": "={{ $('StartEvent').item.json.body.requesteddeliverydate }}"
            },
            {
              "name": "source",
              "value": "={{ $('StartEvent').item.json.body.source }}"
            },
            {
              "name": "totals",
              "value": "={{ ({ \"gross\": $('Read Custom Data: Create Order').item.json.custom.normalizedtotals.gross, \"net\": $('Read Custom Data: Create Order').item.json.custom.normalizedtotals.net, \"tax\": $('Read Custom Data: Create Order').item.json.custom.normalizedtotals.tax }) }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SBPA destination: erp"
        }
      }
    },
    {
